---
import ImpactCounter from '@/components/react/ImpactCounter';
import { IMPACT_STATS } from '@/lib/constants';
import type { SiteSettings } from '@/lib/sanity';

export interface Props {
  settings?: SiteSettings | null;
}

const { settings } = Astro.props;
const stats = settings?.impactStats ?? IMPACT_STATS.map((s) => ({ ...s, suffix: s.suffix }));
---

<section
  id="impacto"
  class="relative overflow-hidden bg-[var(--primary)] py-20 text-[var(--primary-foreground)] md:py-24"
  aria-labelledby="impact-heading"
>
  <div class="bg-azulejo absolute inset-0 opacity-[0.08]" aria-hidden="true"></div>
  <div class="absolute -top-32 right-0 h-80 w-80 rounded-full bg-[color-mix(in_oklab,var(--secondary)_30%,transparent)] blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-32 left-0 h-80 w-80 rounded-full bg-[color-mix(in_oklab,var(--accent)_20%,transparent)] blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent)]">
        Nosso impacto
      </span>
      <h2
        id="impact-heading"
        class="mt-3 text-3xl font-extrabold md:text-5xl"
        style="font-family: var(--font-heading); letter-spacing: -0.02em"
      >
        Números que contam histórias reais
      </h2>
    </div>

    <div class="mt-14">
      <ImpactCounter client:visible stats={stats} />
    </div>
  </div>
</section>
