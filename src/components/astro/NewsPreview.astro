---
import { sanityClient, RECENT_POSTS_QUERY } from '@/lib/sanity';
import type { SanityPost } from '@/lib/sanity';
import PostCard from './PostCard.astro';

let posts: SanityPost[] = [];
try {
  posts = await sanityClient.fetch<SanityPost[]>(RECENT_POSTS_QUERY);
} catch {
  // Sanity not configured yet — show empty state gracefully
  posts = [];
}
---

<section id="noticias" class="py-20 md:py-28" aria-labelledby="news-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--secondary)]">
        Fique por dentro
      </span>
      <h2
        id="news-heading"
        class="mt-3 text-3xl font-extrabold text-[var(--primary)] md:text-5xl"
        style="font-family: var(--font-heading); letter-spacing: -0.02em"
      >
        Notícias & Atualizações
      </h2>
      <p class="mt-3 text-[var(--muted-foreground)]">
        Acompanhe nossas ações, projetos e conquistas recentes.
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="mt-12 text-center text-[var(--muted-foreground)]">
        Nenhuma notícia publicada ainda. Em breve!
      </p>
    )}

    <div class="mt-10 flex justify-center">
      <a
        href="/blog"
        class="inline-flex min-h-12 items-center gap-2 rounded-full border border-[color-mix(in_oklab,var(--primary)_30%,transparent)] bg-[var(--background)] px-6 font-bold text-[var(--primary)] transition-colors hover:bg-[color-mix(in_oklab,var(--secondary)_10%,transparent)]"
        aria-label="Ver todas as notícias do ISLA"
      >
        Ver todas as notícias →
      </a>
    </div>
  </div>
</section>
