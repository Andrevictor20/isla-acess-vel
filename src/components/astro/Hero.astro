---
import { ShieldCheck, Award, Users2, Sparkles, ArrowRight, MessageSquare } from 'lucide-react';
import { SITE } from '@/lib/constants';

const partners = [
  { icon: ShieldCheck, label: 'Selo de Transparência' },
  { icon: Award, label: 'Certificação OSCIP' },
  { icon: Users2, label: 'Rede de Inclusão MA' },
  { icon: Sparkles, label: 'Parceiros Locais' },
];

const quickStats = [
  { k: '8+', v: 'Anos' },
  { k: '1.2k+', v: 'Atendidos' },
  { k: '35', v: 'Projetos' },
];
---

<section
  id="top"
  class="gradient-hero relative overflow-hidden pt-28 pb-20 md:pt-36 md:pb-28"
  aria-labelledby="hero-heading"
>
  <div class="bg-azulejo absolute inset-0 opacity-[0.09]" aria-hidden="true"></div>
  <div class="absolute -top-40 -right-32 h-96 w-96 rounded-full bg-[color-mix(in_oklab,var(--secondary)_20%,transparent)] blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-40 -left-32 h-96 w-96 rounded-full bg-[color-mix(in_oklab,var(--accent)_20%,transparent)] blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 md:px-8 lg:grid-cols-[1.1fr_0.9fr]">
    <!-- Text content -->
    <div class="animate-fade-up">
      <span class="inline-flex items-center gap-2 rounded-full border border-[color-mix(in_oklab,var(--secondary)_40%,transparent)] bg-[color-mix(in_oklab,var(--secondary)_10%,transparent)] px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-[var(--primary)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
        ISLA — São Luís, Maranhão
      </span>

      <h1
        id="hero-heading"
        class="mt-5 text-4xl font-extrabold leading-[1.05] text-[var(--primary)] sm:text-5xl md:text-6xl lg:text-7xl"
        style="font-family: var(--font-heading); letter-spacing: -0.02em"
      >
        A Inclusão é <span class="text-[var(--secondary)]">Para Todos</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--muted-foreground)]">
        {SITE.description}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#acoes"
          id="hero-cta-primary"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[var(--primary)] px-6 font-bold text-[var(--primary-foreground)] shadow-[var(--shadow-elegant)] transition-colors hover:bg-[color-mix(in_oklab,var(--primary)_88%,black)]"
          aria-label="Conheça nossas ações e projetos"
        >
          Conheça Nossas Ações
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
        <a
          href="#contato"
          id="hero-cta-secondary"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-[color-mix(in_oklab,var(--primary)_30%,transparent)] bg-[var(--background)] px-6 font-bold text-[var(--primary)] transition-colors hover:bg-[color-mix(in_oklab,var(--secondary)_10%,transparent)]"
          aria-label="Fale conosco pelo formulário de contato"
        >
          <MessageSquare class="h-4 w-4" aria-hidden="true" />
          Fale Conosco
        </a>
      </div>

      <!-- Certifications / Partners bar -->
      <div
        class="mt-10 rounded-2xl border border-[var(--border)]/70 bg-[var(--background)]/60 px-5 py-4 backdrop-blur"
        aria-label="Parceiros e Certificações"
      >
        <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[var(--muted-foreground)]">
          Parceiros e Certificações
        </p>
        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3 md:grid-cols-4" role="list">
          {partners.map((p) => (
            <li class="flex items-center gap-2 text-xs font-semibold text-[var(--primary)]/80">
              <p.icon class="h-4 w-4 text-[var(--secondary)]" aria-hidden="true" />
              <span>{p.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick stats -->
      <dl class="mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-[var(--border)] pt-6 text-left">
        {quickStats.map((s) => (
          <div>
            <dt class="text-2xl font-extrabold text-[var(--primary)]" style="font-family: var(--font-heading)">{s.k}</dt>
            <dd class="text-xs uppercase tracking-wider text-[var(--muted-foreground)]">{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Logo image -->
    <div class="relative mx-auto animate-fade-in-scale">
      <div class="absolute inset-0 -m-6 rounded-[2.5rem] bg-gradient-to-br from-[color-mix(in_oklab,var(--secondary)_30%,transparent)] via-transparent to-[color-mix(in_oklab,var(--accent)_30%,transparent)] blur-2xl" aria-hidden="true"></div>
      <div class="absolute -inset-2 rounded-[2.25rem] border border-[color-mix(in_oklab,var(--accent)_40%,transparent)]" aria-hidden="true"></div>
      <div class="relative rounded-[2rem] border-4 border-white bg-white p-3 shadow-[var(--shadow-elegant)]">
        <img
          src="/isla-logo.jpg"
          alt={`Logo do ${SITE.name} sobre azulejo maranhense`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="384"
          height="384"
          class="h-52 w-52 rounded-[1.5rem] object-cover sm:h-72 sm:w-72 md:h-96 md:w-96"
        />
      </div>
      <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-[var(--accent)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[var(--accent-foreground)] shadow-[var(--shadow-soft)] animate-pulse">
        DESDE 2018 — SÃO LUÍS, MA
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-scale {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fade-up {
    animation: fade-up 0.7s ease-out both;
  }
  .animate-fade-in-scale {
    animation: fade-in-scale 0.9s ease-out 0.15s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up, .animate-fade-in-scale { animation: none; }
  }
</style>
