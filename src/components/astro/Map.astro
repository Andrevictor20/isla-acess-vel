---
import { CONTACT, SITE, GOOGLE_MAPS_EMBED } from '@/lib/constants';
import { MapPin, Phone, Mail } from 'lucide-react';

const info = [
  { icon: MapPin, label: 'Endereço', value: CONTACT.address, href: null },
  { icon: Phone, label: 'Telefone', value: CONTACT.phone, href: `tel:${CONTACT.phone}` },
  { icon: Mail, label: 'Email', value: CONTACT.email, href: `mailto:${CONTACT.email}` },
];
---

<section id="localizacao" class="bg-[var(--muted)]/40 py-20 md:py-28" aria-labelledby="map-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--secondary)]">
        Onde estamos
      </span>
      <h2
        id="map-heading"
        class="mt-3 text-3xl font-extrabold text-[var(--primary)] md:text-5xl"
        style="font-family: var(--font-heading); letter-spacing: -0.02em"
      >
        Nossa Localização
      </h2>
      <p class="mt-4 text-[var(--muted-foreground)]">{CONTACT.address}</p>
    </div>

    <div class="mt-10 overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--card)] shadow-[var(--shadow-soft)]">
      <div class="h-[300px] w-full bg-[var(--muted)] sm:h-[380px] lg:h-[460px]">
        <iframe
          src={GOOGLE_MAPS_EMBED}
          title={`Mapa da localização do ${SITE.name} em São Luís, Maranhão`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-full w-full border-0"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {info.map((i) => (
        <div class="flex items-start gap-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[color-mix(in_oklab,var(--secondary)_15%,transparent)] text-[var(--secondary)] shrink-0">
            <i.icon class="h-5 w-5" aria-hidden="true" />
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)]">
              {i.label}
            </p>
            {i.href ? (
              <a href={i.href} class="mt-0.5 block font-semibold text-[var(--primary)] hover:text-[var(--secondary)]">
                {i.value}
              </a>
            ) : (
              <p class="mt-0.5 font-semibold text-[var(--primary)]">{i.value}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
