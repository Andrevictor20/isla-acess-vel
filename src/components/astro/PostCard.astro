---
import { urlFor } from '@/lib/image';
import type { SanityPost } from '@/lib/sanity';

export interface Props {
  post: SanityPost;
}

const { post } = Astro.props;

const imageUrl = post.mainImage
  ? urlFor(post.mainImage)?.width(600).height(340).fit('crop').auto('format').url()
  : null;

const publishedFormatted = new Date(post.publishedAt).toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const publishedIso = new Date(post.publishedAt).toISOString();

const categoryColors: Record<string, string> = {
  Institucional: 'bg-[color-mix(in_oklab,var(--primary)_10%,transparent)] text-[var(--primary)]',
  Eventos: 'bg-[color-mix(in_oklab,var(--secondary)_15%,transparent)] text-[var(--secondary)]',
  Imprensa: 'bg-[color-mix(in_oklab,var(--accent)_20%,transparent)] text-amber-700',
  Campanhas: 'bg-[color-mix(in_oklab,var(--primary)_8%,transparent)] text-[var(--primary)]',
};
const catClass = categoryColors[post.category] ?? categoryColors.Institucional;
---

<article
  class="group overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] transition-all hover:-translate-y-1 hover:shadow-[var(--shadow-soft)]"
  aria-labelledby={`post-title-${post._id}`}
>
  <!-- Image -->
  {imageUrl ? (
    <a href={`/blog/${post.slug.current}`} tabindex="-1" aria-hidden="true">
      <div class="overflow-hidden">
        <img
          src={imageUrl}
          alt={post.mainImage?.alt ?? ''}
          loading="lazy"
          decoding="async"
          width="600"
          height="340"
          class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    </a>
  ) : (
    <div class="h-48 bg-[var(--muted)] flex items-center justify-center">
      <span class="text-4xl font-extrabold text-[var(--muted-foreground)]/20" style="font-family: var(--font-heading)">ISLA</span>
    </div>
  )}

  <!-- Content -->
  <div class="p-6">
    <div class="flex items-center justify-between gap-2 mb-4">
      <time datetime={publishedIso} class="text-xs font-semibold uppercase tracking-wider text-[var(--muted-foreground)]">
        {publishedFormatted}
      </time>
      <span class={`rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-wider ${catClass}`}>
        {post.category}
      </span>
    </div>

    <h3
      id={`post-title-${post._id}`}
      class="font-extrabold leading-snug text-[var(--primary)] text-lg"
      style="font-family: var(--font-heading)"
    >
      <a
        href={`/blog/${post.slug.current}`}
        class="hover:text-[var(--secondary)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--ring)] focus-visible:outline-offset-2 rounded"
      >
        {post.title}
      </a>
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-[var(--muted-foreground)] line-clamp-3">
      {post.excerpt}
    </p>

    <a
      href={`/blog/${post.slug.current}`}
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-[var(--secondary)] hover:gap-2.5 transition-all"
      aria-label={`Leia a notícia completa: ${post.title}`}
    >
      Leia mais →
    </a>
  </div>
</article>
