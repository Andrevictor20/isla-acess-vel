---
import { PARTNERS } from '@/lib/constants';
import { urlFor } from '@/lib/image';
import type { SiteSettings } from '@/lib/sanity';

export interface Props {
  settings?: SiteSettings | null;
}

const { settings } = Astro.props;

const sanityPartners = settings?.partners;
const fallbackPartners = PARTNERS;
---

<section id="parceiros" class="bg-[var(--muted)]/40 py-20 md:py-24" aria-labelledby="partners-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--secondary)]">
        Junto com você
      </span>
      <h2
        id="partners-heading"
        class="mt-3 text-3xl font-extrabold text-[var(--primary)] md:text-4xl"
        style="font-family: var(--font-heading); letter-spacing: -0.02em"
      >
        Parceiros e Apoiadores
      </h2>
      <p class="mt-3 text-[var(--muted-foreground)]">Construindo a inclusão juntos</p>
    </div>

    <ul
      class="mt-12 flex gap-4 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible lg:grid-cols-6"
      role="list"
    >
      {sanityPartners
        ? sanityPartners.map((p) => {
            const logoUrl = p.logo
              ? urlFor(p.logo)?.width(160).height(80).fit('max').auto('format').url()
              : null;
            return (
              <li class="flex h-20 min-w-[220px] shrink-0 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] p-4 transition-colors hover:border-[color-mix(in_oklab,var(--secondary)_50%,transparent)] md:min-w-0">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noreferrer noopener" aria-label={`Parceiro: ${p.name}`} class="flex items-center justify-center">
                    {logoUrl ? (
                      <img src={logoUrl} alt={p.logo?.alt ?? p.name} loading="lazy" decoding="async" class="max-h-12 max-w-[140px] object-contain" />
                    ) : (
                      <span class="text-sm font-semibold text-[var(--muted-foreground)]">{p.name}</span>
                    )}
                  </a>
                ) : (
                  <span class="text-sm font-semibold text-[var(--muted-foreground)] text-center">{p.name}</span>
                )}
              </li>
            );
          })
        : fallbackPartners.map((p) => (
            <li class="flex h-20 min-w-[220px] shrink-0 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card)] p-6 text-center text-sm font-semibold text-[var(--muted-foreground)] transition-colors hover:border-[color-mix(in_oklab,var(--secondary)_50%,transparent)] hover:text-[var(--primary)] md:min-w-0">
              {p}
            </li>
          ))
      }
      <li class="flex h-20 min-w-[220px] shrink-0 flex-col items-center justify-center rounded-xl border-2 border-dashed border-[color-mix(in_oklab,var(--secondary)_40%,transparent)] bg-[color-mix(in_oklab,var(--secondary)_5%,transparent)] p-4 text-center transition-colors hover:border-[var(--secondary)] hover:bg-[color-mix(in_oklab,var(--secondary)_10%,transparent)] md:min-w-0">
        <span class="text-xs font-bold text-[var(--secondary)]">+ Seja parceiro</span>
        <a href="#contato" class="mt-1 text-[11px] text-[var(--muted-foreground)] underline underline-offset-2 hover:text-[var(--primary)]">
          Entre em contato
        </a>
      </li>
    </ul>

    <p class="mt-8 text-center text-sm text-[var(--muted-foreground)]">
      Quer se tornar parceiro?{' '}
      <a href="#contato" class="font-semibold text-[var(--primary)] underline underline-offset-4 hover:text-[var(--secondary)]">
        Entre em contato
      </a>.
    </p>
  </div>
</section>
