---
import { Instagram, Facebook, Youtube, Mail, Phone, MapPin } from 'lucide-react';
import { SITE, SOCIAL, NAV_LINKS, CONTACT } from '@/lib/constants';
---

<footer class="relative mt-20 bg-[var(--primary)] text-[var(--primary-foreground)]">
  <div class="h-1 w-full bg-[var(--accent)]" aria-hidden="true"></div>
  <div class="bg-azulejo absolute inset-0 opacity-[0.06]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-14 md:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/isla-logo.jpg"
            alt={`Logo ${SITE.name}`}
            loading="lazy"
            decoding="async"
            width="56"
            height="56"
            class="h-14 w-14 rounded-full object-cover ring-2 ring-[color-mix(in_oklab,var(--secondary)_40%,transparent)]"
          />
          <div>
            <p class="text-lg font-extrabold" style="font-family: var(--font-heading)">{SITE.shortName}</p>
            <p class="text-sm text-[var(--primary-foreground)]/80">{SITE.slogan}</p>
          </div>
        </div>
        <p class="mt-4 max-w-sm text-sm text-[var(--primary-foreground)]/80">
          {SITE.description}
        </p>

        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Instagram do ISLA"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-[var(--accent)] hover:text-[var(--accent-foreground)]"
          >
            <Instagram class="h-5 w-5" aria-hidden="true" />
          </a>
          <a
            href={SOCIAL.facebook}
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Facebook do ISLA"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-[var(--accent)] hover:text-[var(--accent-foreground)]"
          >
            <Facebook class="h-5 w-5" aria-hidden="true" />
          </a>
          <a
            href={SOCIAL.youtube}
            target="_blank"
            rel="noreferrer noopener"
            aria-label="YouTube do ISLA"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-[var(--accent)] hover:text-[var(--accent-foreground)]"
          >
            <Youtube class="h-5 w-5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <nav aria-label="Links rápidos do rodapé">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--secondary)]" style="font-family: var(--font-heading)">
          Navegação
        </h2>
        <ul class="mt-4 space-y-2">
          {NAV_LINKS.map((l) => (
            <li>
              <a
                href={l.href}
                class="inline-flex min-h-11 items-center text-sm text-[var(--primary-foreground)]/85 transition-colors hover:text-[var(--accent)]"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--secondary)]" style="font-family: var(--font-heading)">
          Contato
        </h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <MapPin class="mt-0.5 h-4 w-4 text-[var(--accent)] shrink-0" aria-hidden="true" />
            <span>{CONTACT.address}</span>
          </li>
          <li class="flex items-start gap-3">
            <Phone class="mt-0.5 h-4 w-4 text-[var(--accent)] shrink-0" aria-hidden="true" />
            <a href={`tel:${CONTACT.phone}`} class="hover:text-[var(--accent)]">
              {CONTACT.phone}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <Mail class="mt-0.5 h-4 w-4 text-[var(--accent)] shrink-0" aria-hidden="true" />
            <a href={`mailto:${CONTACT.email}`} class="hover:text-[var(--accent)]">
              {CONTACT.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/15 pt-6 text-xs text-[var(--primary-foreground)]/70 md:flex-row">
      <p>© {new Date().getFullYear()} {SITE.name}. Todos os direitos reservados.</p>
      <p>Site desenvolvido com compromisso de acessibilidade WCAG 2.1 AA.</p>
    </div>
  </div>
</footer>
