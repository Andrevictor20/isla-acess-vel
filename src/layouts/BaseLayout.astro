---
import '@/styles/global.css';
import { SITE, CONTACT } from '@/lib/constants';
import AccessibilityWidget from '@/components/react/AccessibilityWidget';
import WhatsAppButton from '@/components/react/WhatsAppButton';
import BackToTop from '@/components/react/BackToTop';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title = `${SITE.name} — ${SITE.slogan}`,
  description = SITE.description,
  ogImage = `${SITE.url}/og-image.png`,
  ogType = 'website',
  canonical = Astro.url.href,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonical, SITE.url).href;
const pageTitle = title.includes(SITE.shortName) ? title : `${title} | ${SITE.shortName}`;

// Organization JSON-LD (always present)
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  logo: `${SITE.url}/isla-logo.jpg`,
  description: SITE.description,
  foundingDate: String(SITE.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Marechal Castelo Branco, N22',
    addressLocality: 'São Luís',
    addressRegion: 'MA',
    addressCountry: 'BR',
  },
  telephone: CONTACT.phone,
  email: CONTACT.email,
  sameAs: [
    'https://www.instagram.com/institutosaoluisacessivel',
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1B2C6B" />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />

    <!-- Primary Meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="inclusão, acessibilidade, deficiência, São Luís, Maranhão, ISLA, instituto, direitos, PCD, idosos, mobilidade reduzida" />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo (local institution) -->
    <meta name="geo.region" content="BR-MA" />
    <meta name="geo.placename" content="São Luís, Maranhão" />
    <meta name="geo.position" content="-2.5297;-44.3028" />
    <meta name="ICBM" content="-2.5297, -44.3028" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Notícias`} href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Nunito:wght@400;500;600;700;800&display=swap"
    />

    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>

    <!-- JSON-LD: Organization (always) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <!-- JSON-LD: Page-specific (Article, etc.) -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <slot name="head" />
  </head>

  <body>
    <!-- Skip link — first focusable element -->
    <a href="#conteudo-principal" class="skip-link">
      Pular para o conteúdo principal
    </a>

    <slot name="header" />

    <main id="conteudo-principal" tabindex="-1">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Floating React islands -->
    <AccessibilityWidget client:load />
    <WhatsAppButton client:idle />
    <BackToTop client:idle />
  </body>
</html>
