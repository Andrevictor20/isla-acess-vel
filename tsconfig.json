{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "sanity", "scripts"],
  "exclude": ["node_modules"]
}
